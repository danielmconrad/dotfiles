#!/bin/sh

{{ include ".install/utilities.sh" }}
{{ include ".install/ssh.sh" }}

log_section "Installing SSH"

mkdir -p ~/.ssh
touch ~/.ssh/config

if ! grep -q "IdentityFile ~/.ssh/id_ed25519" ~/.ssh/config; then
  printf "Host *\n  AddKeysToAgent yes\n  IdentityFile ~/.ssh/id_ed25519\n" >> ~/.ssh/config
fi

if [ -f ~/.ssh/id_ed25519 ]; then
  log "SSH key already exists, skipping"
else
  ssh-keygen -t ed25519 -C "$(ssh_key_label "$(date +%Y-%m-%d)")" -f ~/.ssh/id_ed25519
  eval "$(ssh-agent -s)"
  ssh-add ~/.ssh/id_ed25519
fi
